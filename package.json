    "@tailwindcss/vite": "^4.1.11",
    "concurrently": "^9.0.1",
    "laravel-vite-plugin": "^3.1",
    "svelte": "^5.16.0",
    "tailwindcss": "^4.1.1",
    "typescript": "^5.7.2",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@laravel/vite-plugin-wayfinder": "^0.1.3",
    "@types/node": "^22.13.5",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "svelte-check": "^4.1.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5",
